# Copy to .env locally. Exported environment variables take precedence.
MOCK_LLM=true
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional separate critic model; defaults to LLM_MODEL.
CRITIC_MODEL=
# Optional OAuth access token obtained locally; public catalogue works without it.
# Do not paste browser cookies or client secrets into this variable.
VKUSVILL_ACCESS_TOKEN=
